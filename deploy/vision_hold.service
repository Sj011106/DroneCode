# =====================================================================================
# deploy/vision_hold.service  -  start vision_hold.py automatically on the APB
# -------------------------------------------------------------------------------------
# IN PLAIN WORDS
#   Tells Linux: "when the board boots, start our program; if it ever stops, start it
#   again after 2 seconds". No keyboard or screen needed on the drone.
#   install.sh fills in @USER@ and @DIR@ and installs this file, but does NOT enable it:
#   the service would grab the camera and the flight-controller port and fight every
#   manual test. Enable it only for event day (docs/WORKLIST.md phase 4):
#       sudo systemctl enable --now vision_hold
#   APB values (Stage 2 package): flight controller = /dev/ttymxc2, Justice D = /dev/video2,
#   given as --camera 2 (= /dev/video2). NO gpioset here: Stage 2 forbids changing the APB
#   GPIO lines (they route the FC link and the pilot video). Link silent? Ask the organisers.
#   Add --record to ExecStart for practice flights (saves to /sdcard when a card is in).
#
# Useful commands on the board:
#   sudo systemctl status vision_hold     # running? last lines of output
#   journalctl -u vision_hold -f          # live output
#   sudo systemctl stop vision_hold       # ALWAYS before running anything by hand
#   sudo systemctl disable vision_hold    # don't start at boot any more
#
# REFERENCE: systemd.service manual, https://www.freedesktop.org/software/systemd/man/systemd.service.html
# =====================================================================================

[Unit]
# REVIEW M1: never stop retrying (default: 5 quick failures in 10 s = dead until reboot)
StartLimitIntervalSec=0
Description=Vision position hold (GNSS-denied)
After=network.target msp_sender.service

[Service]
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
# --no-gps-fallback: no GNSS may aid the hold (Stage 2 section 04).
# BETAFLIGHT (the firmware the aircraft ships with): sticks go through the msp_sender service, which owns
# /dev/ttymxc2. Enable both:  systemctl enable --now msp_sender vision_hold
ExecStart=@DIR@/venv/bin/python vision_hold.py --fc betaflight --camera 2 --no-gps-fallback
# ARDUCOPTER instead (only if the team flashed it): use this line and do NOT enable msp_sender:
#ExecStart=@DIR@/venv/bin/python vision_hold.py --fc ardupilot --connect /dev/ttymxc2 --camera 2 --no-gps-fallback
# always: also restart after a clean exit (e.g. "Camera lost for 5 s - stopping.")
Restart=always
RestartSec=1
Nice=-10

[Install]
WantedBy=multi-user.target
